parameters:
    level: 5
    reportUnmatchedIgnoredErrors: false
    paths:
        - .
    excludePaths:
        - vendor/*
        - i18n/*
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    ignoreErrors:
        # Constantes de tiempo de WordPress, no están en los stubs.
        - '#Constant (SECOND|MINUTE|HOUR|DAY|WEEK|MONTH|YEAR)_IN_SECONDS not found#'
        # Constantes definidas en el archivo principal, no visibles para PHPStan.
        - '#Constant CORRARFO_(PLUGIN_FILE|PLUGIN_DIR|PLUGIN_URL) not found#'
